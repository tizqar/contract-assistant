# Copy to .env. Every value has a default in contract_assistant/config.py.
# The thesis repo, a sibling of this one -- read-only from here.
DIPLOMSKI_DIR=../diplomski
EXTRACTOR_MODEL_ID=models/ettin-150m-cuad-seed3407
EXTRACTOR_NAME=ettin-encoder-150m_w1024_s256_multi_neg1_seed3407_e3v
EXTRACTOR_DEVICE=auto
# Chosen on validation in diplomski/src/operating_point.py (seed 3407, epoch 3)
TAU_LOW=0.06
TAU_HIGH=0.91
TAU_SOURCE=diplomski/results/ettin-encoder-150m_w1024_s256_multi_neg1_seed3407_e3v_operating_point.json
# Tesseract languages for scanned PDF pages; the ones not installed are dropped.
OCR_LANGUAGES=eng+srp_latn+srp
# ollama, openai or none (embedding router only)
LLM_BACKEND=ollama
# The router model. The same model as GEN_MODEL keeps one model resident; on 2026-10-21
# qwen3.5:4b routed the test questions at F1 0.93 against 0.67 for qwen3:1.7b.
LLM_MODEL=qwen3.5:4b
# Only for LLM_BACKEND=openai, which needs the api extra
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Summaries, key terms, explanations and answers from passages: served by LLM_BACKEND too.
# GEN_NUM_CTX is the context size of both Ollama clients, so one model serves both.
GEN_MODEL=qwen3.5:4b
GEN_TIMEOUT_S=120
GEN_NUM_CTX=8192
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
# Chosen by router-tune on the dev questions on 2026-10-21 (eval/results/embedding_threshold.json)
EMBEDDING_THRESHOLD=0.58
CACHE_DIR=cache
# The web app's database: accounts, contracts, decisions and the activity log. `make db-up`
# starts the Postgres of docker-compose.yml on this address; the command line keeps CACHE_DIR.
DATABASE_URL=postgresql+psycopg://contract_assistant:contract_assistant@127.0.0.1:5433/contract_assistant
# How long a sign-in lasts, and whether its cookie needs HTTPS (true behind an HTTPS proxy).
SESSION_DAYS=14
COOKIE_SECURE=false

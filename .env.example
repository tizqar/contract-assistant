# Copy to .env. Every value has a default in contract_assistant/config.py.
# The thesis repo, a sibling of this one -- read-only from here.
DIPLOMSKI_DIR=../diplomski
EXTRACTOR_MODEL_ID=models/ettin-150m-cuad-seed3407
EXTRACTOR_NAME=ettin-encoder-150m_w1024_s256_multi_neg1_seed3407_e3v
EXTRACTOR_DEVICE=auto
# Chosen on validation in diplomski/src/operating_point.py (seed 3407, epoch 3)
TAU_LOW=0.06
TAU_HIGH=0.91
TAU_SOURCE=diplomski/results/ettin-encoder-150m_w1024_s256_multi_neg1_seed3407_e3v_operating_point.json
# ollama, openai or none (embedding router only)
LLM_BACKEND=ollama
LLM_MODEL=qwen3:1.7b
# Only for LLM_BACKEND=openai, which needs the api extra
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Summaries and explanations: served by LLM_BACKEND too, with their own model. Free text
# only, so a model on Ollama's MLX runtime works although it has no JSON schema support.
GEN_MODEL=qwen3.5:4b
GEN_TIMEOUT_S=120
GEN_NUM_CTX=8192
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
# Untuned: set by hand from a few questions until router-tune (plan 02 section 3.8)
EMBEDDING_THRESHOLD=0.55
CACHE_DIR=cache
